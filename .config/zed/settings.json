{
  // General
  "cli_default_open_behavior": "existing_window",
  // Appearance
  "theme": "Ayu Glass Mirage",
  "buffer_font_family": "Maple Mono NF CN",
  "buffer_font_size": 18,
  "buffer_font_features": {
    "cv07": true,
    "cv61": true,
    "cv97": true,
    "cv99": true,
    "ss03": true,
  },
  // Editor
  "autosave": "on_window_change",
  "which_key": { "enabled": true },
  "mouse_wheel_zoom": true,
  "autoscroll_on_clicks": true,
  "sticky_scroll": { "enabled": true },
  "auto_signature_help": true,
  "show_signature_help_after_edits": true,
  "minimap": { "show": "auto" },
  "toolbar": { "code_actions": true },
  "soft_wrap": "editor_width",
  "indent_guides": { "active_line_width": 2 },
  "format_on_save": "on",
  "code_actions_on_format": { "source.organizeImports": true },
  "completion_menu_scrollbar": "auto",
  "inlay_hints": { "toggle_on_modifiers_press": { "alt": true } },
  "code_lens": "menu",
  "extend_comment_on_newline": false,
  // Languages & Tools
  "lsp_results_location": "picker",
  "semantic_tokens": "combined",
  "document_folding_ranges": "on",
  "document_symbols": "on",
  "completions": { "lsp_insert_mode": "replace_subsequence" },
  "prettier": { "allowed": true },
  // Search & Files
  "use_smartcase_search": true,
  // Window & Layout
  "status_bar": {
    "active_encoding_button": "enabled",
    "line_endings_button": true,
    "show_active_file": true,
  },
  "title_bar": { "show_branch_status_icon": true },
  "tabs": { "show_diagnostics": "all", "git_status": true, "file_icons": true },
  "bottom_dock_layout": "right_aligned",
  // Panels
  "project_panel": { "diagnostic_badges": true, "bold_folder_labels": true },
  "git_panel": {
    "status_style": "label_color",
    "collapse_untracked_diff": true,
    "tree_view": true,
    "file_icons": true,
  },
  // Terminal
  "terminal": {
    "font_family": "FiraCode Nerd Font",
    "line_height": { "custom": 1.27 },
    "cursor_shape": "bar",
    "bell": "system",
  },
  // Version Control
  "git": {
    "inline_blame": { "location": "status_bar", "show_commit_summary": true },
    "path_style": "file_path_first",
  },
  // Collaboration
  "calls": { "mute_on_join": true },
  // AI
  "agent": {
    "single_file_review": true,
    "default_profile": "write",
    "play_sound_when_agent_done": "when_hidden",
    "show_turn_stats": true,
    "default_model": {
      "provider": "google",
      "model": "gemini-3.6-flash",
      "enable_thinking": true,
      "effort": "high",
    },
  },
  "agent_servers": { "antigravity-acp": { "type": "registry" } },
  "edit_predictions": {
    "provider": "zed",
    "mode": "subtle",
    "copilot": {
      "proxy": null,
      "proxy_no_verify": null,
    },
  },
  // Specify languages
  "languages": {
    "Python": {
      "language_servers": ["ty", "ruff", "!basedpyright", "discord_presence"],
    },
    "GDScript": {
      "formatter": {
        "external": {
          "command": "gdscript-formatter",
          "arguments": ["--reorder-code"],
        },
      },
    },
  },
  "lsp": {
    "typescript-language-server": {
      "initialization_options": { "vtsls": { "autoUseWorkspaceTsdk": true } },
    },
  },
}
